# Copia este archivo como .env y completa los valores. NUNCA subas .env al repositorio.

PORT=3000

# Orígenes permitidos para CORS (separados por coma). Ej. la URL del frontend en Render.
# Si se deja vacío, se permite cualquier origen (solo recomendado en desarrollo).
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Credenciales del panel de administración
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-contrasena
# Cadena larga y aleatoria para firmar los tokens (ej. `openssl rand -hex 32`)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# --- Firebase (usa UNA de las siguientes opciones) ---
# Opción A (recomendada para Render): el JSON de la cuenta de servicio codificado en base64
#   macOS/Linux:  base64 -i serviceAccountKey.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Opción B (local): ruta al archivo JSON de la cuenta de servicio
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
